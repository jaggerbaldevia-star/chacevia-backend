{
  "functions": {
    "api/creative-deck.js": {
      "maxDuration": 60
    },
    "api/research-deck.js": {
      "maxDuration": 60
    },
    "api/schedule-extract.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/reminder-text",
      "destination": "/api/schedule-extract?action=reminder-text"
    },
    {
      "source": "/api/notes-pdf",
      "destination": "/api/pdf?action=notes-pdf"
    },
    {
      "source": "/api/direction-pdf",
      "destination": "/api/pdf?action=direction-pdf"
    },
    {
      "source": "/api/study-set",
      "destination": "/api/pdf?action=study-set"
    },
    {
      "source": "/api/stripe-checkout",
      "destination": "/api/stripe?action=checkout"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe?action=webhook"
    },
    {
      "source": "/api/pro-status",
      "destination": "/api/stripe?action=status"
    },
    {
      "source": "/api/account-delete",
      "destination": "/api/account?action=delete"
    },
    {
      "source": "/api/canvas-connect",
      "destination": "/api/schedule-extract?action=canvas-connect"
    },
    {
      "source": "/api/canvas-sync",
      "destination": "/api/schedule-extract?action=canvas-sync"
    },
    {
      "source": "/api/canvas-status",
      "destination": "/api/schedule-extract?action=canvas-status"
    },
    {
      "source": "/api/canvas-disconnect",
      "destination": "/api/schedule-extract?action=canvas-disconnect"
    },
    {
      "source": "/api/canvas-cron",
      "destination": "/api/schedule-extract?action=canvas-cron"
    },
    {
      "source": "/api/revenuecat-webhook",
      "destination": "/api/stripe?action=rc-webhook"
    },
    {
      "source": "/api/premium-status",
      "destination": "/api/stripe?action=premium"
    },
    {
      "source": "/api/trial-claim",
      "destination": "/api/stripe?action=trial"
    },
    {
      "source": "/api/trial-warned",
      "destination": "/api/stripe?action=trial-warned"
    },
    {
      "source": "/api/shorten",
      "destination": "/api/schedule-extract?action=shorten"
    },
    {
      "source": "/api/shorten-backfill",
      "destination": "/api/schedule-extract?action=shorten-backfill"
    },
    {
      "source": "/api/canvas-feed-audit",
      "destination": "/api/schedule-extract?action=canvas-feed-audit"
    },
    {
      "source": "/api/reminder-dispatch",
      "destination": "/api/schedule-extract?action=reminder-dispatch"
    },
    {
      "source": "/api/canvas-catchup",
      "destination": "/api/schedule-extract?action=canvas-catchup"
    },
    {
      "source": "/api/apple-token",
      "destination": "/api/account?action=apple-token"
    }
  ],
  "headers": [
    {
      "source": "/voice/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        }
      ]
    }
  ]
}
